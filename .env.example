# PDFLens configuration. Copy this file to .env and fill in the blanks:
#   cp .env.example .env
# .env is listed in .gitignore. Never commit it.
#
# docker compose reads this file for ${VARIABLE} substitution, and Flask,
# Alembic and pytest load it automatically in dev mode (via python-dotenv).

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=pdflens
# Use letters and digits only: the password is also embedded in the URLs below.
POSTGRES_PASSWORD=
POSTGRES_DB=pdflens
# Host port for Postgres. 5433 avoids clashing with a Postgres installed on
# your machine, which usually owns 5432.
POSTGRES_HOST_PORT=5433

# --- Backend ----------------------------------------------------------------
# Used when you run Flask, Alembic or pytest directly on your machine (dev
# mode). Inside Docker, docker-compose.yml points the backend at the
# "postgres" and "ollama" service names instead.
# 127.0.0.1 rather than "localhost": on Windows, localhost tries IPv6 (::1)
# first, but Docker only publishes these ports on IPv4, so every new
# connection would stall until the IPv6 attempt timed out.
DATABASE_URL=postgresql+psycopg://pdflens:PASSWORD@127.0.0.1:5433/pdflens
# Integration tests use a separate database (created on first start by
# docker/postgres/init). Its name must end in _test, as a safety check.
TEST_DATABASE_URL=postgresql+psycopg://pdflens:PASSWORD@127.0.0.1:5433/pdflens_test

# Signs session cookies. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Sessions and request security -----------------------------------------
# Secure cookies are only sent over HTTPS. Leave this false while you use
# PDFLens over plain http://127.0.0.1; set it to true behind HTTPS.
SESSION_COOKIE_SECURE=false
# Hours until a session cookie expires and the user has to log in again.
SESSION_LIFETIME_HOURS=8
# Other browser origins allowed to call the API, comma-separated, exact
# origins only (no wildcards). Leave empty: the frontend is served from the
# same origin as the API, through Nginx or the Vite dev proxy.
CORS_ALLOWED_ORIGINS=
# Number of reverse proxies in front of the backend whose X-Forwarded-For
# header can be trusted for the client IP. 0 when nothing is in front.
TRUSTED_PROXY_COUNT=0
# Per-IP limits, in Flask-Limiter notation ("N per minute;M per hour").
RATE_LIMIT_LOGIN=5 per minute;30 per hour
RATE_LIMIT_REGISTER=10 per hour

# --- Ollama -----------------------------------------------------------------
# Host port for the Ollama container. 11435 avoids clashing with an Ollama
# app installed on your machine, which owns 11434.
OLLAMA_HOST_PORT=11435
OLLAMA_BASE_URL=http://127.0.0.1:11435
# Embeddings always come from this model, whichever LLM answers questions.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
